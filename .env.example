# Local development settings. Copy to .env (git-ignored): cp .env.example .env
# Docker Compose reads .env; nothing needs to be exported on the host.
#
# docker/db/init.sql only runs on an empty data volume. After changing a database
# name or password here, recreate the volume (this deletes local data):
#   docker compose down -v && make up

# ── Postgres bootstrap superuser ── used only by the db image to run init.sql;
# never by the app or the tests, because superusers bypass RLS.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=app

# ── Application role passwords ── read by docker/db/init.sql.
# Keep these URL-safe (letters, digits, - _ . ~), as they are embedded in the URLs below.
APP_OWNER_PASSWORD=change-me-owner
APP_USER_PASSWORD=change-me-user
APP_READONLY_PASSWORD=change-me-readonly

# ── Backend database URLs ── "db" is the Compose service name.
# Migrations, org sync, seeding and tests (app_owner). Passed only to the one-shot
# `ops` service; the running backend never receives it.
DATABASE_URL_OWNER=postgresql+asyncpg://app_owner:${APP_OWNER_PASSWORD}@db:5432/${POSTGRES_DB}
# Runtime requests (app_user: not an owner, NOBYPASSRLS).
DATABASE_URL_APP=postgresql+asyncpg://app_user:${APP_USER_PASSWORD}@db:5432/${POSTGRES_DB}
# Admin analytics (app_readonly: NOBYPASSRLS).
DATABASE_URL_READONLY=postgresql+asyncpg://app_readonly:${APP_READONLY_PASSWORD}@db:5432/${POSTGRES_DB}

# ── Web security ──
# Origins allowed to send non-GET requests to /api (CSRF check), comma-separated.
ALLOWED_ORIGINS=http://localhost:3000
# "local" drops the Secure flag from the session cookie so it works over plain HTTP.
# Any other value (e.g. production) sets Secure.
APP_ENV=local

# ── Hot reload ── polling makes file watching reliable on WSL2 bind mounts.
# Backend (uvicorn --reload, via watchfiles).
WATCHFILES_FORCE_POLLING=true
# Frontend (next dev, via webpack's Watchpack).
WATCHPACK_POLLING=true

# ── Embeddings and seeding ──
# Where fastembed caches BAAI/bge-small-en-v1.5 (the fastembed_cache Docker volume).
EMBED_CACHE_DIR=/models
# Optional fixed "now" for `make seed`, as an ISO datetime; no offset means the org's
# timezone (e.g. 2026-11-09T10:00). Empty = the real clock. Evals set it so every run
# sees the same order and booking dates.
SEED_NOW=
