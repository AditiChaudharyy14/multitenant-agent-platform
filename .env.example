# Local development settings. Copy to .env (git-ignored): cp .env.example .env
# Docker Compose reads .env; nothing needs to be exported on the host.
#
# docker/db/init.sql only runs on an empty data volume. After changing a database
# name or password here, recreate the volume (this deletes local data):
#   docker compose down -v && make up

# ── Postgres bootstrap superuser ── used only by the db image to run init.sql;
# never by the app or the tests, because superusers bypass RLS.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_DB=app

# ── Application role passwords ── read by docker/db/init.sql.
# Keep these URL-safe (letters, digits, - _ . ~), as they are embedded in the URLs below.
APP_OWNER_PASSWORD=change-me-owner
APP_USER_PASSWORD=change-me-user
APP_READONLY_PASSWORD=change-me-readonly
# Eval-only role on db-ephemeral: may create and drop the per-scenario clone databases,
# nothing else. Used only by the one-shot `eval` service.
APP_EVAL_PASSWORD=change-me-eval

# ── Backend database URLs ── "db" is the Compose service name.
# Migrations, org sync, seeding and tests (app_owner). Passed only to the one-shot
# `ops` service; the running backend never receives it.
DATABASE_URL_OWNER=postgresql+asyncpg://app_owner:${APP_OWNER_PASSWORD}@db:5432/${POSTGRES_DB}
# Runtime requests (app_user: not an owner, NOBYPASSRLS).
DATABASE_URL_APP=postgresql+asyncpg://app_user:${APP_USER_PASSWORD}@db:5432/${POSTGRES_DB}
# Admin analytics (app_readonly: NOBYPASSRLS).
DATABASE_URL_READONLY=postgresql+asyncpg://app_readonly:${APP_READONLY_PASSWORD}@db:5432/${POSTGRES_DB}
# Eval runner only (app_eval): connects to db-ephemeral's maintenance db to CREATE/DROP
# the per-scenario clones. Tests and evals never use the dev `db` (see docker-compose.yml);
# their other database URLs are built there from the role passwords above.
DATABASE_URL_EVAL=postgresql+asyncpg://app_eval:${APP_EVAL_PASSWORD}@db-ephemeral:5432/postgres

# ── Web security ──
# Origins allowed to send non-GET requests to /api (CSRF check), comma-separated.
ALLOWED_ORIGINS=http://localhost:3000
# "local" drops the Secure flag from the session cookie so it works over plain HTTP.
# Any other value (e.g. production) sets Secure.
APP_ENV=local

# ── Frontend ── the Next server proxies /api/* here, so the browser stays same-origin.
BACKEND_URL=http://backend:8000

# ── Hot reload ── polling makes file watching reliable on WSL2 bind mounts.
# Backend (uvicorn --reload, via watchfiles).
WATCHFILES_FORCE_POLLING=true
# Frontend (next dev, via webpack's Watchpack).
WATCHPACK_POLLING=true

# ── Embeddings and seeding ──
# Where fastembed caches BAAI/bge-small-en-v1.5 (the fastembed_cache Docker volume).
EMBED_CACHE_DIR=/models
# Optional fixed "now" for `make seed`, as an ISO datetime; no offset means the org's
# timezone (e.g. 2026-11-09T10:00). Empty = the real clock. Evals set it so every run
# sees the same order and booking dates.
SEED_NOW=

# ── LLM ──
# Provider: gemini (default) | mistral | fake. Mistral's free plan isn't available to this
# account ("Upgrade to activate"), so its adapter is built and tested offline only.
# Keys go to the backend container only; `make test` never sees them.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Free-tier quotas are per model and tracked separately (AI Studio dashboard: Flash Lite
# models have 15 RPM / 500 RPD; non-Lite Flash only 5 RPM / 20 RPD, so it isn't used).
# gemma-4-31b-it is not a fallback: models.list shows no function-calling support.
LLM_MODEL_GEMINI=gemini-3.5-flash-lite
# Comma-separated, tried in order when the primary is out of budget or keeps returning 429.
LLM_FALLBACK_MODELS_GEMINI=gemini-3.1-flash-lite
# Kept below the vendor limits for headroom. The daily budget is per model and counted in
# Postgres (llm_usage), resetting at midnight Pacific; `make llm-budget` shows usage.
LLM_RPM_GEMINI=12
LLM_DAILY_BUDGET_GEMINI=450
MISTRAL_API_KEY=
LLM_MODEL_MISTRAL=mistral-small-latest
LLM_FALLBACK_MODELS_MISTRAL=
LLM_RPM_MISTRAL=60
LLM_DAILY_BUDGET_MISTRAL=1000
# off: live calls. record: live calls, saved to cassettes. replay: cassettes only (no key,
# no quota). Cassettes live under eval/cassettes/<scenario>.json.
EVAL_MODE=off
EVAL_CASSETTE_DIR=/eval/cassettes
# With LLM_PROVIDER=fake: a YAML file that scripts the model's replies, so the UI can run
# end to end without spending quota (make e2e sets this; path inside the backend container).
FAKE_SCENARIO_FILE=

# ── Evals (make eval / make eval-live) ──
# The frozen "now" the eval template database is seeded at (no offset = org timezone).
# Scenarios freeze the agent's clock at this time unless they set their own seed_now.
EVAL_SEED_NOW=2026-11-12T10:00
# LLM-as-judge for make eval ARGS=--judge (scores only; never decides pass/fail).
EVAL_JUDGE_MODEL=gemini-3.1-flash-lite
# Recording stops when the primary model has fewer requests than this left today.
EVAL_MIN_BUDGET_LEFT=100
